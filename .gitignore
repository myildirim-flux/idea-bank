# ============================================================================
# IDEA BANK - GITIGNORE
# Secure Note-Taking App with AI & Cloud Storage
# ============================================================================

# ============================================================================
# ENVIRONMENT & SECRETS (CRITICAL - NEVER COMMIT THESE)
# ============================================================================
.env
*.env
lib/core/env.g.dart
**/*.jks
**/*.keystore
**/key.properties
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart

# ============================================================================
# FLUTTER/DART
# ============================================================================
# Dart tool directory
.dart_tool/

# Package dependencies
.packages
.pub-cache/
.pub/
# pubspec.lock (Tracked for Flutter apps to ensure deterministic CI builds)

# Build outputs
/build/
**/build/

# Flutter plugin files
.flutter-plugins
.flutter-plugins-dependencies

# Generated files (only ignore secret-containing env.g.dart)
lib/core/env.g.dart
*.freezed.dart
*.mocks.dart

# Documentation
**/doc/api/
.dart_doc/

# Desktop Flutter specific
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ============================================================================
# ANDROID
# ============================================================================
# Gradle
.gradle/
**/android/.gradle/

# Local configuration
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/GeneratedPluginRegistrant.kt

# Build outputs
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/build/
**/android/.cxx/

# Keystore (NEVER COMMIT)
*.jks
*.keystore

# ============================================================================
# iOS / macOS
# ============================================================================
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/ios/Podfile.lock
**/macos/Podfile.lock

