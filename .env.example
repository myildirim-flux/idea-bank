# Appwrite Configuration Template
# Copy this file to .env and fill in your actual values.
# Get these values from your Appwrite console: https://cloud.appwrite.io/

# Appwrite API Endpoint (e.g., https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=https://your-appwrite-instance.com/v1

# Appwrite Project Identifier
APPWRITE_PROJECT_ID=your-project-id

# Appwrite Database Identifier
APPWRITE_DATABASE_ID=your-database-id

# Appwrite Collection ID for Ideas
APPWRITE_TABLE_ID=your-ideas-collection-id

# Appwrite Collection ID for User Profiles
APPWRITE_USER_TABLE_ID=your-users-collection-id

# Appwrite Storage Bucket ID
APPWRITE_BUCKET_ID=your-storage-bucket-id

# Appwrite API Key (Required for build_runner to generate env.g.dart)
# Scopes: databases.read, databases.write, files.read, files.write, users.read, users.write
APPWRITE_API_KEY=your-appwrite-api-key

# IMPORTANT: NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
